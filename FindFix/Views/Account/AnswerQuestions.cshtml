@using System.Reflection.Emit
@model List< FindFix.Models.SecurityQuestion>
@{
    ViewData ["Title"] ="Answer your questions";
}
<h2>Answer your questions</h2>
<p>Pick one answer for each question, You need at least 2 correct. Tries left <strong>@ViewBag.AttemptsLeft</strong></p>
    @if(ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

<form asp-controller="Account" asp-action="AnswerQuestions" method="post">
    @for(int i = 0; i < Model.Count;  i++)
    {
         <div class="mb-4">
            <p><strong>@(i + 1).@Model[i].Text</strong></p>
            @for(int j=0; j < @Model[i].Options.Count; j++)
            {
                var optionId = $"q{i}_{j}";
                <div class="form-check">
                     <input class="form-check-input" type="radio" name="q@(i)" id="@optionId" value ="@Model[i].Options[j]" />
                  <label class="form-check-label"  for="@optionId">@Model[i].Options[j]</label>
                </div>
                    
                
            }
         </div>
    }
    <button type = "Submit" class="btn btn-primary">Check answers</button> 
</form>