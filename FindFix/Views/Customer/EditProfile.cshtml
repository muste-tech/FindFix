@model FindFix.Models.Customer
@{
    ViewData["Title"] = "My Profile";
}
<h2>My Profile</h2>
<form asp-controller="Customer" asp-action="EditProfile" method="post">
    <div class="form_group mb-3">
        <label for="Location">Location (city or area)</label>
        <input type="text" name="location" id="location" class="form-control" value="@Model.Location" placeholder="e.g Akure">
        
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
</form>
